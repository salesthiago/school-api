# App
PORT=3000
API_PUBLIC_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# MongoDB
MONGODB_URI=mongodb://localhost:27017/gpschool

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES=7d

# Storage (dev: local disk; produção: STORAGE_DRIVER=s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
STORAGE_SIGNING_SECRET=change-me-storage-secret

# S3 (só usado quando STORAGE_DRIVER=s3)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Itaú (Pix / Boleto) — preencher com credenciais reais antes de produção
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
ITAU_CERTIFICATE_PATH=
ITAU_WEBHOOK_SECRET=change-me-webhook-secret

# Bunny.net — token do webhook de status de vídeo (configurar a URL manualmente
# no painel do Bunny: Video Library → API → Webhook URL, veja backend/deploy/README.md)
BUNNY_WEBHOOK_SECRET=change-me-bunny-webhook-secret
